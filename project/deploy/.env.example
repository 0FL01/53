# Копия ключей remote /opt/srv/53/.env — только плейсхолдеры, без значений.
# Реальные значения живут на сервере и в Git не попадают.
# Секреты (carrier cert/key, reset seed) здесь НЕ хранятся — только *_FILE путями в compose.
DMSG_DOMAIN=msg.example.com
DNS_BIND_IP=203.0.113.10
DNS_PUBLIC_PORT=53
DNS_INTERNAL_PORT=5353
MSGD_ADDR=127.0.0.1:7000
