<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <include layout="@layout/toolbar"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/plan" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="16dp"/>
            <Button android:id="@+id/btn_migrate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/update_copy"/>
            <Button android:id="@+id/btn_unseal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/restore_copy"/>
            <TextView android:id="@+id/loss" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:layout_marginVertical="16dp" android:background="@color/warning_surface" android:text="@string/reinstall_loss"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/storage_password_disclosure" android:paddingBottom="16dp"/>
            <Button android:id="@+id/btn_wipe_cache" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clear_cache"/>
            <TextView android:id="@+id/info" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:accessibilityLiveRegion="polite"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
