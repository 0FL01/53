<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">
    <TextView android:id="@+id/peer" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <ListView android:id="@+id/messages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <EditText android:id="@+id/composer" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Сообщение (до 4 KiB)" />
    <Button android:id="@+id/btn_send" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Отправить" />
    <Button android:id="@+id/btn_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Повторить очередь" />
    <TextView android:id="@+id/info" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
