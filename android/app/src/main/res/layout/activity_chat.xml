<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:id="@+id/chat_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="center_vertical">
        <Button android:id="@+id/btn_back" style="@style/Widget.Dmsg.Icon" android:layout_width="48dp" android:layout_height="48dp" android:drawableTop="@drawable/ic_back" android:contentDescription="@string/back"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
            <TextView android:id="@+id/screen_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:accessibilityHeading="true"/>
            <TextView android:id="@+id/peer" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp"/>
        </LinearLayout>
        <Button android:id="@+id/btn_contact" style="@style/Widget.Dmsg.Icon" android:layout_width="48dp" android:layout_height="48dp" android:drawableTop="@drawable/ic_menu" android:contentDescription="@string/contact_card"/>
    </LinearLayout>
    <org.dmsg.client.NoticeScrollView android:id="@+id/chat_notice" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/info" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:textSize="14sp" android:background="@color/warning_surface" android:accessibilityLiveRegion="polite"/>
    </org.dmsg.client.NoticeScrollView>
    <ListView android:id="@+id/messages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:transcriptMode="disabled" android:contentDescription="@string/message_history"/>
    <LinearLayout android:id="@+id/chat_actions" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/btn_history_retry" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/refresh_messages"/>
        <Button android:id="@+id/btn_retry" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/retry_queue"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/edit_banner" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="8dp" android:background="@color/accent_soft" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/editing_message" android:textSize="14sp" android:accessibilityHeading="true"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/voice_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="8dp" android:background="@color/accent_soft" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/voice_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:padding="8dp"/>
            <TextView android:id="@+id/voice_hint" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="14sp"/>
        </LinearLayout>
        <org.dmsg.client.VoiceWaveformView android:id="@+id/voice_waveform" android:layout_width="match_parent" android:layout_height="48dp"/>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                <Button android:id="@+id/voice_discard" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp" android:text="@string/voice_discard"/>
                <Button android:id="@+id/voice_pause" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp" android:text="@string/voice_pause"/>
                <Button android:id="@+id/voice_preview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp" android:text="@string/voice_preview"/>
                <Button android:id="@+id/voice_send" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp" android:text="@string/voice_send"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:padding="8dp">
        <EditText android:id="@+id/composer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minLines="1" android:maxLines="3" android:inputType="textMultiLine|textCapSentences" android:imeOptions="flagNoExtractUi" android:hint="@string/message_hint" android:saveEnabled="false" android:importantForAutofill="no"/>
        <Button android:id="@+id/btn_cancel_edit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:text="@string/cancel" android:contentDescription="@string/cancel_edit" android:visibility="gone"/>
        <Button android:id="@+id/btn_save_edit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:text="@string/save_edit" android:visibility="gone"/>
        <Button android:id="@+id/btn_send" style="@style/Widget.Dmsg.Icon" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:drawableTop="@drawable/ic_send" android:contentDescription="@string/send_message"/>
        <org.dmsg.client.VoiceMicView android:id="@+id/btn_mic" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
