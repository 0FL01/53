<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No GMS/FCM: notifications are local only (see DmsgService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Identity state excluded from cloud backup (ARCH M4). -->
    <application
        android:allowBackup="false"
        android:fullBackupOnly="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.Dmsg"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ChatActivity" android:exported="false" />
        <activity android:name=".ProfileActivity" android:exported="false" />
        <activity android:name=".ScannerActivity" android:exported="false" />
        <activity android:name=".StorageActivity" android:exported="false" />
        <activity android:name=".DiagnosticsActivity" android:exported="false" />

        <!-- Single always-on foreground service (no second FGS mode;
             "Economy" is only a poll-interval flag, see DmsgService). -->
        <service
            android:name=".DmsgService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
