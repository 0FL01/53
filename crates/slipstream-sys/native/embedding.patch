diff --git a/src/slipstream_pin.c b/src/slipstream_pin.c
--- a/src/slipstream_pin.c
+++ b/src/slipstream_pin.c
@@ -80,7 +80,2 @@
-int ss_pin_certificate(picoquic_quic_t *quic, const char *path) {
-    BIO *bio = BIO_new_file(path, "r");
-    if (!bio) return -1;
-    X509 *cert = PEM_read_bio_X509(bio, NULL, NULL, NULL);
-    X509 *extra = PEM_read_bio_X509(bio, NULL, NULL, NULL);
-    BIO_free(bio);
-    if (!cert || extra) { X509_free(cert); X509_free(extra); return -1; }
+static int pin_x509(picoquic_quic_t *quic, X509 *cert) {
+    if (!cert) return -1;
@@ -98,1 +93,35 @@
 }
+
+int ss_pin_certificate(picoquic_quic_t *quic, const char *path) {
+    BIO *bio = BIO_new_file(path, "r");
+    if (!bio) return -1;
+    X509 *cert = PEM_read_bio_X509(bio, NULL, NULL, NULL);
+    X509 *extra = PEM_read_bio_X509(bio, NULL, NULL, NULL);
+    BIO_free(bio);
+    if (!cert || extra) { X509_free(cert); X509_free(extra); return -1; }
+    return pin_x509(quic, cert);
+}
+
+#ifdef DMSG_EMBEDDED
+/* In-memory full leaf certificate; the existing DER/signature verifier is
+ * unchanged. No SPKI-only pin, trust-store lookup, file, env or argv. */
+int dmsg_pin_bytes(picoquic_quic_t *quic, const uint8_t *bytes, size_t length) {
+    if (!bytes || !length || length > 65536) return -1;
+    X509 *cert = NULL;
+    if (length >= 27 && !memcmp(bytes, "-----BEGIN CERTIFICATE-----", 27)) {
+        BIO *bio = BIO_new_mem_buf(bytes, (int)length);
+        if (!bio) return -1;
+        cert = PEM_read_bio_X509(bio, NULL, NULL, NULL);
+        X509 *extra = PEM_read_bio_X509(bio, NULL, NULL, NULL);
+        BIO_free(bio);
+        if (extra) { X509_free(cert); X509_free(extra); return -1; }
+    } else {
+        const unsigned char *cursor = bytes;
+        cert = d2i_X509(NULL, &cursor, (long)length);
+        if (cursor != bytes + length) { X509_free(cert); return -1; }
+    }
+    return pin_x509(quic, cert);
+}
+#endif
