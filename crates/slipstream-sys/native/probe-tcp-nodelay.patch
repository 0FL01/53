diff --git a/include/slipstream_probe_tcp.h b/include/slipstream_probe_tcp.h
new file mode 100644
--- /dev/null
+++ b/include/slipstream_probe_tcp.h
@@ -0,0 +1,22 @@
+#ifndef SLIPSTREAM_PROBE_TCP_H
+#define SLIPSTREAM_PROBE_TCP_H
+
+#ifdef DMSG_PROBE_TCP_NODELAY
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+
+/* TCP creation seams only. The caller retains FD ownership on failure. */
+static int ss_probe_tcp_nodelay(int fd) {
+    int enabled = 1;
+    if (setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &enabled, sizeof(enabled))) return -1;
+    int actual = 0;
+    socklen_t length = sizeof(actual);
+    if (getsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &actual, &length)) return -1;
+    if (length != sizeof(actual) || actual != 1) return -1;
+    return 0;
+}
+#endif
+
+#endif
+
