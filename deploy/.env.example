# Копия ключей remote /opt/srv/53/.env — только плейсхолдеры, без значений.
# Реальные значения живут на сервере и в Git не попадают.
# Секреты (carrier cert/key, reset seed) здесь НЕ хранятся — только *_FILE путями в compose.
DMSG_DOMAIN=msg.example.com
DNS_BIND_IP=203.0.113.10
DNS_PUBLIC_PORT=53
DNS_INTERNAL_PORT=5353
# Dedicated bridge; check host/VPN/Docker routes before selecting a subnet.
# The static address must be in the subnet, but OUTSIDE the dynamic pool.
DMSG_NETWORK_SUBNET=172.28.53.0/24
DMSG_NETWORK_DYNAMIC_RANGE=172.28.53.128/25
DMSG_SLIPSTREAM_IPV4=172.28.53.2
DMSG_MSGD_IPV4=172.28.53.3
# Каталог секретов на сервере (carrier cert/key, reset seed). Только путь, не значения.
SECRETS_DIR=./secrets
